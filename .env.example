# ---- Google Sheets (the only database) ----
# The long ID in the Sheet link:  https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Local only: path of the downloaded key file (never uploaded). On a server use the JSON below.
# GOOGLE_SERVICE_ACCOUNT_FILE=.data/google-key.json
# Service account key. Paste the WHOLE downloaded JSON file on one line ...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ... or use these two instead (the private key keeps its \n line breaks inside quotes)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# ---- App ----
# Random string (32+ chars) used to sign sign-in cookies:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: if set, first-time setup (/setup) asks for this key, so nobody else can claim a fresh install
SETUP_KEY=
# Public address of the app (used in email / WhatsApp links)
APP_URL=
# Optional: seconds-level read cache for Sheets (ms). Default 4000
SHEETS_CACHE_MS=4000
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# ---- Scheduler (reminders, overdue alerts, repeating entries, morning summary) ----
# Anything that calls  GET /api/cron/tick  with  Authorization: Bearer <CRON_SECRET>  (Vercel Cron does this automatically)
CRON_SECRET=

# ---- Optional alerts ----
# Email via any SMTP server, e.g. smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# WhatsApp through any gateway that accepts a JSON POST {to, message}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_COUNTRY_CODE=91

# Credential Vault: 64 hex characters (32 random bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and never lose or change it. Without it the vault stays closed.
VAULT_KEY=
